+  private fun dispatchPlaybackControl(control: String) {
+    playbackControlListener?.invoke(control)
+  }
+
+  private fun setEqualizerPresetInternal(preset: String) {
+    equalizerPreset = preset
+    withPlayerOnAppThread {
+      applyEqualizerInternal()
+    }
+  }
+
+  private fun applyEqualizerInternal() {
+    releaseEqualizer()
+    if (equalizerPreset == "off") return
+
+    val audioSessionId = currentPlayer?.ref?.audioSessionId ?: return
+    if (audioSessionId <= 0) return
+
+    try {
+      val effect = Equalizer(0, audioSessionId)
+      val minLevel = effect.bandLevelRange[0].toInt()
+      val maxLevel = effect.bandLevelRange[1].toInt()
+
+      for (band in 0 until effect.numberOfBands.toInt()) {
+        val frequencyHz = effect.getCenterFreq(band.toShort()) / 1000
+        val ratio = when (equalizerPreset) {
+          "bass" -> when {
+            frequencyHz < 250 -> 0.65
+            frequencyHz < 1000 -> 0.2
+            frequencyHz > 4000 -> -0.1
+            else -> 0.0
+          }
+          "vocal" -> if (frequencyHz in 300..3500) 0.45 else -0.12
+          "treble" -> when {
+            frequencyHz > 4000 -> 0.6
+            frequencyHz < 250 -> -0.1
+            else -> 0.0
+          }
+          else -> 0.0
+        }
+        val level = if (ratio >= 0) maxLevel * ratio else -minLevel * ratio
+        effect.setBandLevel(band.toShort(), level.toInt().coerceIn(minLevel, maxLevel).toShort())
+      }
+
+      effect.enabled = true
+      equalizer = effect
+    } catch (_: Exception) {
+      releaseEqualizer()
     }
   }
 
+  private fun releaseEqualizer() {
+    try {
+      equalizer?.enabled = false
+      equalizer?.release()
+    } catch (_: Exception) {
+      // The audio session may already have been released.
+    }
+    equalizer = null
+  }
+
+  private fun updatePlaybackModesInternal(shuffleEnabled: Boolean, repeatMode: String) {
+    this.shuffleEnabled = shuffleEnabled
+    this.repeatMode = repeatMode
+    withPlayerOnAppThread { player ->
+      updateSessionCustomLayout(player.isPlaying)
+      postOrStartForegroundNotification(startInForeground = false)
+    }
+  }
